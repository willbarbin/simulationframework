import matplotlib.pyplot as plt
import math

dt = 0.01

# Planet database
PLANETS = {
    "earth":  {"g": 9.81, "rho": 1.225, "atm_height": 100000},
    "mars":   {"g": 3.71, "rho": 0.020, "atm_height": 11000},
    "venus":  {"g": 8.87, "rho": 65.0,  "atm_height": 250000},
    "moon":   {"g": 1.62, "rho": 0.0,   "atm_height": 0},
}

cd = 0.75

v = [0]
x = [0]
t = [0]
delta_v_used = [0]

def startup():
    print("Available planets:", ", ".join(PLANETS.keys()))
    planet = input("Choose planet: ")
    planet = planet.lower()
    thrust = float(input("Enter thrust (N): "))
    burn_time = float(input("Enter burn time (s): "))
    area = float(input("Enter cross-sectional area (m^2): "))
    mass_initial = float(input("Enter initial mass (kg): "))
    mass_final = float(input("Enter final mass after burnout (kg): "))
    isp = float(input("Enter engine Isp (s): "))

    return planet, thrust, burn_time, area, mass_initial, mass_final, isp

def drag_force(v, rho, area):
    return 0.5 * rho * cd * area * v**2

def f_v(v, thrust, area, mass, g, rho):
    D = drag_force(v, rho, area)
    return (thrust - D) / mass - g

def rk4_v(v, thrust, area, mass, g, rho):
    k1 = f_v(v, thrust, area, mass, g, rho)
    k2 = f_v(v + 0.5 * dt * k1, thrust, area, mass, g, rho)
    k3 = f_v(v + 0.5 * dt * k2, thrust, area, mass, g, rho)
    k4 = f_v(v + dt * k3, thrust, area, mass, g, rho)
    return v + (dt / 6) * (k1 + 2*k2 + 2*k3 + k4)

def rk4_x(x, v):
    k1 = v
    k2 = v + 0.5 * dt * k1
    k3 = v + 0.5 * dt * k2
    k4 = v + dt * k3
    return x + (dt / 6) * (k1 + 2*k2 + 2*k3 + k4)

def tsiolkovsky_delta_v(m0, m1, isp):
    g0 = 9.81
    return isp * g0 * math.log(m0 / m1)

planet, thrust, burn_time, area, m0, m1, isp = startup()
planet_data = PLANETS[planet]

g = planet_data["g"]
rho0 = planet_data["rho"]
atm_height = planet_data["atm_height"]

mass = m0
mass_flow_rate = (m0 - m1) / burn_time

total_delta_v = tsiolkovsky_delta_v(m0, m1, isp)

while x[-1] >= 0:
    time = t[-1]

    # Thrust phase
    if time <= burn_time:
        current_thrust = thrust
        mass -= mass_flow_rate * dt
    else:
        current_thrust = 0

    # Atmospheric density decreases with altitude
    if x[-1] < atm_height:
        rho = rho0 * (1 - x[-1] / atm_height)
    else:
        rho = 0  # vacuum

    new_v = rk4_v(v[-1], current_thrust, area, mass, g, rho)
    new_x = rk4_x(x[-1], v[-1])

    v.append(new_v)
    x.append(new_x)
    t.append(time + dt)

    # Track Δv used
    if time <= burn_time:
        delta_v_used.append(total_delta_v * (time / burn_time))
    else:
        delta_v_used.append(total_delta_v)

print("Fastest velocity:", max(v))
print("Average velocity:", sum(v) / len(v))
print("Maximum altitude:", max(x))
print("Total Δv capability:", total_delta_v)

show_plots = input("Show plots? (y/n): ")
if show_plots.lower() == "y":
    plt.figure()
    plt.plot(t, v)
    plt.xlabel("Time (s)")
    plt.ylabel("Velocity (m/s)")
    plt.title("Velocity vs Time")

    plt.figure()
    plt.plot(t, x)
    plt.xlabel("Time (s)")
    plt.ylabel("Altitude (m)")
    plt.title("Altitude vs Time")

    plt.figure()
    plt.plot(t, delta_v_used)
    plt.xlabel("Time (s)")
    plt.ylabel("Δv Used (m/s)")
    plt.title("Delta‑V Usage Over Time")

    plt.show()
